#!/usr/bin/env bash
# Re-run when zshrc changes: {{ include "dot_zshrc" | sha256sum }}
set -euo pipefail

zsh_dir="${HOME}/.oh-my-zsh"
zsh_custom="${zsh_dir}/custom"
spaceship_dir="${HOME}/.zsh/spaceship"
themes_dir="${zsh_custom}/themes"
plugins_dir="${zsh_custom}/plugins"

clone_if_missing() {
  local url="$1" dest="$2"
  if [[ ! -d "${dest}/.git" ]]; then
    mkdir -p "$(dirname "${dest}")"
    git clone --depth=1 "${url}" "${dest}"
  fi
}

clone_if_missing "https://github.com/ohmyzsh/ohmyzsh.git" "${zsh_dir}"
clone_if_missing "https://github.com/zsh-users/zsh-autosuggestions.git" "${plugins_dir}/zsh-autosuggestions"
clone_if_missing "https://github.com/zsh-users/zsh-syntax-highlighting.git" "${plugins_dir}/zsh-syntax-highlighting"
clone_if_missing "https://github.com/spaceship-prompt/spaceship-prompt.git" "${spaceship_dir}"

mkdir -p "${themes_dir}"
ln -sfn "${spaceship_dir}" "${themes_dir}/spaceship"
ln -sfn "${themes_dir}/spaceship/spaceship.zsh" "${themes_dir}/spaceship.zsh-theme"
