# Swap between crt-green and crt-amber
theme = crt-green

# GNOME/desktop sessions often still export SHELL=bash after chsh; force zsh here.
command = /usr/bin/zsh

font-family = "FiraCode Nerd Font"
font-size = 14

background-opacity = 0.85

# CRT shader — tweaked copy of in-game-crt with reduced bloom and stronger scanlines.
# Bloom is built into the CRT shader so the separate bloom.glsl is no longer needed.
# Base shaders: https://github.com/hackr-sh/ghostty-shaders
custom-shader = ~/.config/ghostty/crt-tweaked.glsl

# UK ISO: match tmux muscle memory — " is Shift+2, % is Shift+5 (no prefix).
keybind = ctrl+shift+digit_2=new_split:down
keybind = ctrl+shift+digit_5=new_split:right

# Pane focus — same as tmux (prefix is Ctrl+A, matching ~/.config/tmux/tmux.conf).
# Double Ctrl+A sends a literal Ctrl+A through to the shell (readline, etc.).
keybind = ctrl+a>arrow_up=goto_split:up
keybind = ctrl+a>arrow_down=goto_split:down
keybind = ctrl+a>arrow_left=goto_split:left
keybind = ctrl+a>arrow_right=goto_split:right
keybind = ctrl+a>o=goto_split:next
keybind = ctrl+a>ctrl+a=text:\x01
